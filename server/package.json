{
  "name": "final-project-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --env-file=.env --watch server.js",
    "db:schema": "node --env-file=.env db/run.js db/schema.sql",
    "db:seed": "node --env-file=.env db/run.js db/seed.sql",
    "db:reset": "npm run db:schema && npm run db:seed"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "firebase-admin": "^12.7.0",
    "helmet": "^8.3.0",
    "multer": "^2.0.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
