# Copy to .env and fill in. .env is git-ignored; this file is committed.
# On a deployed host, set these in the dashboard instead: there is no .env there.

# Local:    postgresql://postgres:devpassword@localhost:5432/nara
# Hosted:   postgresql://user:pass@host.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://postgres:devpassword@localhost:5432/nara

# Comma-separated, no trailing slash, no path. An origin is scheme + host + port.
CORS_ORIGINS=http://localhost:5173

# Set to production on your host. Express and several libraries behave better,
# including not sending stack traces to your users.
NODE_ENV=development

# Optional. Path to the Firebase service-account JSON. Leave unset locally
# (server/firebase-service-account.json is used). On Render, add it as a
# Secret File and set this to /etc/secrets/firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/firebase-service-account.json

# Do NOT set PORT locally or on the host. The host sets it for you.
